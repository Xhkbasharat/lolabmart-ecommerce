# =========================================
# SELLER: CREATE PRODUCT
# =========================================

@app.route("/seller/product/create", methods=["GET", "POST"])
@login_required
def create_product():

    if current_user.role != "seller":
        abort(403)

    if request.method == "POST":

        name = request.form.get("name", "").strip()
        description = request.form.get("description", "").strip()
        category = request.form.get("category", "").strip()
        image_url = request.form.get("image_url", "").strip()

        try:
            price = Decimal(request.form.get("price", "0"))
            stock = int(request.form.get("stock", "0"))
        except (ValueError, TypeError, InvalidOperation):
            flash("Enter a valid price and stock quantity.", "error")
            return redirect(url_for("create_product"))

        if (
            not name or not description or not category
            or not price.is_finite()
            or price <= 0 or stock < 0
        ):
            flash("Please enter valid product information.", "error")
            return redirect(url_for("create_product"))

        product = Product(
            name=name,
            description=description,
            category=category,
            price=price,
            stock=stock,
            image_url=image_url or None,
            origin="Lolab Valley",
            seller_id=current_user.id
        )

        db.session.add(product)
        db.session.commit()

        flash("Your product has been listed.", "success")

        return redirect(url_for("seller_dashboard"))

    return render_template("seller/create_product.html")


# =========================================
# SELLER: DELETE PRODUCT
# =========================================

@app.route(
    "/seller/product/delete/<int:product_id>",
    methods=["POST"]
)
@login_required
def delete_product(product_id):

    if current_user.role != "seller":
        abort(403)

    product = Product.query.filter_by(
        id=product_id,
        seller_id=current_user.id
    ).first_or_404()

    has_orders = OrderItem.query.filter_by(
        product_id=product.id
    ).first()

    if has_orders:
        flash(
            "This product belongs to an existing order and cannot be deleted.",
            "error"
        )
        return redirect(url_for("seller_dashboard"))

    db.session.delete(product)
    db.session.commit()

    flash("Product deleted successfully.", "success")

    return redirect(url_for("seller_dashboard"))


