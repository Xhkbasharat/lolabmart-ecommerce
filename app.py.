# =========================================
# SHOPPING CART
# =========================================

@app.route("/cart")
def cart():

    cart_data = session.get("cart", {})
    cart_items = []
    total = Decimal("0.00")

    for product_id, quantity in cart_data.items():

        product = Product.query.filter_by(
            id=int(product_id),
            origin="Lolab Valley"
        ).first()

        if product is None:
            continue

        quantity = int(quantity)

        subtotal = product.price * quantity
        total += subtotal

        cart_items.append({
            "product": product,
            "quantity": quantity,
            "subtotal": subtotal
        })

    return render_template(
        "cart.html",
        cart_items=cart_items,
        total=total
    )


@app.route("/cart/add/<int:product_id>", methods=["POST"])
def add_to_cart(product_id):

    product = Product.query.filter_by(
        id=product_id,
        origin="Lolab Valley"
    ).first_or_404()

    if product.stock <= 0:
        flash("This product is currently unavailable.", "error")
        return redirect(url_for("product_detail", product_id=product.id))

    cart_data = session.get("cart", {})
    key = str(product_id)

    current_quantity = int(cart_data.get(key, 0))

    if current_quantity >= product.stock:
        flash("Available stock limit reached.", "error")
    else:
        cart_data[key] = current_quantity + 1
        session["cart"] = cart_data
        session.modified = True

        flash("Product added to your cart.", "success")

    return redirect(url_for("cart"))


@app.route("/cart/update/<int:product_id>", methods=["POST"])
def update_cart(product_id):

    product = Product.query.filter_by(
        id=product_id,
        origin="Lolab Valley"
    ).first_or_404()

    quantity = request.form.get("quantity", type=int)

    cart_data = session.get("cart", {})
    key = str(product_id)

    if quantity is None or quantity < 1:
        cart_data.pop(key, None)

    elif quantity > product.stock:
        flash("Quantity exceeds available stock.", "error")

    else:
        cart_data[key] = quantity

    session["cart"] = cart_data
    session.modified = True

    return redirect(url_for("cart"))


@app.route("/cart/remove/<int:product_id>", methods=["POST"])
def remove_from_cart(product_id):

    cart_data = session.get("cart", {})
    cart_data.pop(str(product_id), None)

    session["cart"] = cart_data
    session.modified = True

    flash("Product removed from cart.", "success")

    return redirect(url_for("cart"))


# =========================================
# CHECKOUT
# =========================================

@app.route("/checkout", methods=["GET", "POST"])
@login_required
def checkout():

    cart_data = session.get("cart", {})

    if not cart_data:
        flash("Your cart is empty.", "error")
        return redirect(url_for("products"))

    cart_items = []
    total = Decimal("0.00")

    for product_id, quantity in cart_data.items():

        product = Product.query.filter_by(
            id=int(product_id),
            origin="Lolab Valley"
        ).first()

        quantity = int(quantity)

        if (
            product is None
            or quantity < 1
            or quantity > product.stock
        ):
            flash("A product is unavailable or has insufficient stock.", "error")
            return redirect(url_for("cart"))

        subtotal = product.price * quantity
        total += subtotal

        cart_items.append((product, quantity, subtotal))

    if request.method == "POST":

        address = request.form.get(
            "shipping_address", ""
        ).strip()

        if not address:
            flash("Please enter your delivery address.", "error")
            return redirect(url_for("checkout"))

        try:

            order = Order(
                customer_id=current_user.id,
                total_amount=total,
                shipping_address=address
            )

            db.session.add(order)

            for product, quantity, subtotal in cart_items:

                locked_product = Product.query.filter_by(
                    id=product.id
                ).with_for_update().first()

                if (
                    locked_product is None
                    or locked_product.stock < quantity
                ):
                    raise ValueError(
                        f"Insufficient stock for {product.name}."
                    )

                locked_product.stock -= quantity

                order_item = OrderItem(
                    order=order,
                    product_id=product.id,
                    product_name=product.name,
                    quantity=quantity,
                    unit_price=product.price
                )

                db.session.add(order_item)

            db.session.commit()

            session.pop("cart", None)

            flash("Your order has been placed successfully!", "success")

            return redirect(url_for("my_orders"))

        except Exception as error:

            db.session.rollback()
            app.logger.exception("Checkout failed")

            flash(
                str(error) if isinstance(error, ValueError)
                else "Unable to place your order. Please try again.",
                "error"
            )

            return redirect(url_for("cart"))

    return render_template(
        "checkout.html",
        cart_items=cart_items,
        total=total
    )


